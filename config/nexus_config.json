{
    "config_version": 1,
    "nexus": {
        "name": "Nexus",
        "version": "1.1.1",
        "environment": "local"
    },
    "ai": {
        "provider": "gemini",
        "model": "gemini-3.8-flash"
    },
    "paths": {
        "inbox": "data/inbox",
        "academic": "data/knowledge/academic/Semester1",
        "modules": "app/capabilities",
        "logs": "logs",
        "backups": "backups"
    },
    "features": {
        "process_notes": true,
        "pc_control": false,
        "screen_vision": false,
        "communications": false
    },
    "runtime": {
        "log_level": "INFO",
        "poll_interval_seconds": 5
    }
}